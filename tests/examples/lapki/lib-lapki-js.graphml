<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns">
  <data key="gFormat">Cyberiada-GraphML-1.0</data>
  <key attr.name="format" attr.type="string" for="graphml" id="gFormat"></key>
  <key attr.name="name" attr.type="string" for="graph" id="dName"></key>
  <key attr.name="name" attr.type="string" for="node" id="dName"></key>
  <key attr.name="stateMachine" for="graph" id="dStateMachine"></key>
  <key attr.name="geometry" for="node" id="dGeometry"></key>
  <key attr.name="note" attr.type="string" for="node" id="dNote"></key>
  <key attr.name="vertex" attr.type="string" for="node" id="dVertex"></key>
  <key attr.name="data" attr.type="string" for="node" id="dData"></key>
  <key attr.name="data" attr.type="string" for="edge" id="dData"></key>
  <graph id="M1">
    <data key="dStateMachine"></data>
    <data key="dName">Main</data>
    <node id="coreMeta">
      <data key="dNote">formal</data>
      <data key="dName">CGML_META</data>
      <data key="dData">standardVersion/ 1.0

</data>
    </node>
    <node id="init">
      <data key="dVertex">initial</data>
      <data key="dGeometry">
        <rect x="-60.5" y="20" width="-1" height="-1"></rect>
      </data>
    </node>
    <node id="n0">
      <data key="dName">Work</data>
      <data key="dData">entry/
start()
</data>
      <data key="dGeometry">
        <rect x="0" y="0" width="400" height="300"></rect>
      </data>
      <graph id="n0">
        <node id="n0::n1">
          <data key="dName">Step</data>
          <data key="dGeometry">
            <rect x="20" y="60" width="200" height="100"></rect>
          </data>
        </node>
      </graph>
    </node>
    <node id="note">
      <data key="dNote">informal</data>
      <data key="dData">A note.</data>
      <data key="dGeometry">
        <point x="500" y="0"></point>
      </data>
    </node>
    <edge id="init-n0" source="init" target="n0"></edge>
  </graph>
  <graph id="M2">
    <data key="dStateMachine"></data>
    <data key="dName">Second</data>
    <node id="">
      <data key="dNote">formal</data>
      <data key="dName">CGML_META</data>
      <data key="dData">standardVersion/ undefined

</data>
    </node>
    <node id="m2s">
      <data key="dName">Idle</data>
      <data key="dGeometry">
        <rect x="0" y="0" width="200" height="100"></rect>
      </data>
    </node>
  </graph>
</graphml>
